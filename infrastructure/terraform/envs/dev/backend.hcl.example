# Copy to backend.hcl and fill in with the values for your account.
# terraform init -backend-config=backend.hcl
#
# The bucket and the DynamoDB table are created once per account, outside this
# root, because a root cannot create the store that holds its own state.

bucket         = "REPLACE-fineract-tfstate-<account-id>"
key            = "fineract/dev/landing-zone.tfstate"
region         = "REPLACE-region"
dynamodb_table = "REPLACE-fineract-tfstate-lock"
encrypt        = true
kms_key_id     = "REPLACE-arn-of-the-state-cmk"
