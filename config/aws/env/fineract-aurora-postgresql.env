# Aurora PostgreSQL connection settings (mirrors config/docker/env/fineract-postgresql.env).
# Usernames and passwords come from Secrets Manager via config/aws/secrets.env.

FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME=org.postgresql.Driver
FINERACT_HIKARI_JDBC_URL=jdbc:postgresql://${AURORA_WRITER_ENDPOINT}:5432/fineract_tenants
FINERACT_DEFAULT_TENANTDB_HOSTNAME=${AURORA_WRITER_ENDPOINT}
FINERACT_DEFAULT_TENANTDB_PORT=5432
FINERACT_DEFAULT_TENANTDB_RO_HOSTNAME=${AURORA_READER_ENDPOINT}
FINERACT_DEFAULT_TENANTDB_RO_PORT=5432
FINERACT_DEFAULT_TENANTDB_RO_NAME=fineract_default
