# Secrets Manager references injected through the ECS task definition "secrets" block, never as plaintext env.
# Each value is an ECS valueFrom: <secret ARN>[:<json-key>:<version-stage>:<version-id>].
# The ARN placeholders are filled at deploy time from the Terraform "secrets" module outputs.

FINERACT_HIKARI_USERNAME=${SECRET_ARN_TENANT_STORE_DB}:username::
FINERACT_HIKARI_PASSWORD=${SECRET_ARN_TENANT_STORE_DB}:password::
FINERACT_DEFAULT_TENANTDB_UID=${SECRET_ARN_DEFAULT_TENANT_DB}:username::
FINERACT_DEFAULT_TENANTDB_PWD=${SECRET_ARN_DEFAULT_TENANT_DB}:password::
FINERACT_DEFAULT_TENANTDB_RO_UID=${SECRET_ARN_DEFAULT_TENANT_DB_RO}:username::
FINERACT_DEFAULT_TENANTDB_RO_PWD=${SECRET_ARN_DEFAULT_TENANT_DB_RO}:password::
FINERACT_DEFAULT_MASTER_PASSWORD=${SECRET_ARN_TENANT_MASTER_PASSWORD}
FINERACT_DEFAULT_TENANTDB_MASTER_PASSWORD=${SECRET_ARN_TENANT_MASTER_PASSWORD}
FINERACT_SERVER_SSL_KEY_STORE_PASSWORD=${SECRET_ARN_KEYSTORE}:password::
