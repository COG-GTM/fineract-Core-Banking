#
# AWS observability profile: JSON logs to stdout (shipped to CloudWatch Logs by the
# awslogs/FireLens log driver), Micrometer metrics to CloudWatch, and traces over OTLP
# to the ADOT collector sidecar (config/aws/adot/collector-config.yaml), which exports
# them to AWS X-Ray. Credentials come from the ECS task role; nothing secret here.

FINERACT_LOGGING_JSON_ENABLED=true

# Enables the Spring Cloud AWS region/credentials and CloudWatch registry auto-configurations (excluded by default).
FINERACT_AUTOCONFIGURE_EXCLUDE=
FINERACT_AWS_CREDENTIALS_INSTANCE_PROFILE=false
FINERACT_MANAGEMENT_CLOUDWATCH_ENABLED=true
FINERACT_MANAGEMENT_CLOUDWATCH_NAMESPACE=fineract
FINERACT_MANAGEMENT_CLOUDWATCH_STEP=1m

# Property name is misspelled in application.properties; keep it as is.
FINERACT_MANAGEMENT_TRACIING_ENABLED=true
FINERACT_MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
FINERACT_MANAGEMENT_TRACING_SERVICE_NAME=fineract
FINERACT_MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
FINERACT_MANAGEMENT_METRICS_DISTRIBUTION_HTTP_SERVER_REQUESTS=true
