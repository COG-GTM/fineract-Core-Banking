# Sample migration environment. Copy to migration.env, fill in, and keep it out of git.
# Passwords are read from the environment so they never reach a dump command line or a log.

# mariadb | postgresql
SOURCE_ENGINE=mariadb
SOURCE_HOST=source-db.internal
SOURCE_PORT=3306
SOURCE_USER=migration
# export SOURCE_PASSWORD in your shell or read it from a secret store; do not put it in this file
SOURCE_TENANTS_DB=fineract_tenants

TARGET_ENGINE=postgresql
TARGET_HOST=target-db.internal
TARGET_PORT=5432
TARGET_USER=migration
# export TARGET_PASSWORD in your shell or read it from a secret store; do not put it in this file
TARGET_TENANTS_DB=fineract_tenants

# Where dumps and evidence are written. Must have room for a production-sized copy.
WORK_DIR=/var/tmp/fineract-migration

# Freeze-window rehearsal: how long to wait for replication to drain before giving up (seconds).
CATCHUP_TIMEOUT_SECONDS=1800
# Maximum acceptable replication lag before the freeze is declared complete (seconds).
CATCHUP_LAG_THRESHOLD_SECONDS=0
